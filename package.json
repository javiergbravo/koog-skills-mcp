{
	"name": "koog-skills-mcp-workspace",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset version && git add . && git commit -m 'chore: release' && git tag v$(node -p \"require('./packages/mcp/package.json').version\") && git push && git push --tags",
		"release:local": "node scripts/release.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.31.0",
		"@types/node": "^22.15.0",
		"tsup": "^8.5.1",
		"typescript": "^5.8.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	}
}
