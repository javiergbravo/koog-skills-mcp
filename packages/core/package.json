{
	"name": "@koog-skills/core",
	"version": "0.1.0",
	"description": "Shared parser, schema, loader, and search index for Koog skills",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"minisearch": "^7.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"tsup": "^8.5.1",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	},
	"license": "Apache-2.0"
}
