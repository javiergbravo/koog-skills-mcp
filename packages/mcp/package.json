{
	"name": "koog-skills-mcp",
	"version": "0.1.0",
	"description": "MCP server exposing Koog framework documentation to any MCP-capable client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"koog-skills-mcp": "./dist/bin.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup && node ../../scripts/build-skills-index.mjs --out ./dist/skills.json && chmod +x dist/bin.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"start": "node dist/bin.js"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"gray-matter": "^4.0.3",
		"minisearch": "^7.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@koog-skills/core": "workspace:*",
		"@types/node": "^22.15.0",
		"tsup": "^8.5.1",
		"typescript": "^5.8.3",
		"vitest": "^4.1.5"
	},
	"license": "Apache-2.0",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"koog",
		"koog-agents",
		"ai-agents",
		"kotlin",
		"jetbrains",
		"claude",
		"claude-code"
	]
}
